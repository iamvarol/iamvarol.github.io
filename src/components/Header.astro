---
import ThemeToggle from './ThemeToggle.astro';
import { site, isActive } from '../lib/site';
import { visibleNav } from '../lib/nav';

const pathname = Astro.url.pathname;

// The gates (empty blog, draft About, unpublished Work) live in lib/nav.ts so
// this header and the 404 page agree about which pages exist.
const items = await visibleNav();
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="wordmark" aria-label={`${site.shortName} — home`}>
      {site.shortName}
    </a>

    <nav aria-label="Primary" class="primary">
      <ul class="nav">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', isActive(item.href, pathname) && 'is-current']}
                aria-current={isActive(item.href, pathname) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* Deliberately not sticky. A fixed bar costs a compositor layer and a blur on
     every scroll frame, and the pages here are short enough not to need it. */
  .site-header {
    border-block-end: var(--hairline) solid var(--rule);
  }

  @media print {
    .site-header {
      display: none;
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    min-block-size: 4rem;
    padding-block: var(--s-3);
  }

  .wordmark {
    font-size: var(--t-small);
    font-weight: var(--w-semibold);
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    /* Held still across a page swap — see the view-transition block in base.css. */
    view-transition-name: wordmark;
  }

  .primary {
    margin-inline-start: auto;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tools {
    display: flex;
    align-items: center;
  }

  /* Five links, a wordmark and a toggle do not fit on one 320px row, and a
     hamburger would cost the header its zero JavaScript. So below 30rem the
     bar becomes two rows — wordmark and toggle above, the links below — which
     is plain flex wrapping and needs no script. */
  @media (max-width: 30rem) {
    .primary {
      order: 3;
      flex-basis: 100%;
      margin-inline-start: 0;
    }

    .tools {
      margin-inline-start: auto;
    }

    .nav {
      gap: var(--s-3) var(--s-4);
    }
  }

  .nav-link {
    position: relative;
    font-size: var(--t-meta);
    font-weight: var(--w-medium);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .nav-link:hover {
    color: var(--fg);
  }

  .is-current {
    color: var(--fg);
  }

  /* The current-page mark. One element on the site carries this
     view-transition-name at a time, so on navigation the browser slides the
     hairline from the old item to the new one with no script involved. */
  .is-current::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: calc(-1 * var(--s-2));
    block-size: var(--hairline);
    background: var(--accent);
    view-transition-name: nav-current;
  }
</style>

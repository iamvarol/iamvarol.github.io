---
import { site, socials } from '../lib/site';

const year = new Date().getFullYear();
const links = socials.filter((s) => s.primary);
---

<footer class="site-footer">
  <div class="wrap inner">
    <p class="meta">© {year} {site.name}</p>

    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="link"
              rel={link.href.startsWith('http') ? 'me noopener' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--s-section);
    border-block-start: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-6);
  }

  .meta {
    margin: 0;
    font-size: var(--t-meta);
    color: var(--faint);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    font-size: var(--t-meta);
    color: var(--muted);
    text-decoration: none;
  }

  .link:hover {
    color: var(--accent);
  }
</style>

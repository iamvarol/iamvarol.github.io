---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';
import { readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, description, tags, draft, part } = post.data;
const minutes = readingTime(post.body);
---

<article class="item reveal">
  <a href={`/blog/${post.id}/`} class="link">
    <span class="row">
      {/* Mono date rather than a counter: an index position shifts every time a
          post is added, so "01" would not mean anything stable. The series
          part is the one number that is stable, so it may appear. */}
      <FormattedDate date={date} format="iso" class="date" />
      {part && <span class="part">Part {part}</span>}
      <span class="minutes">{minutes} min</span>
      {draft && <span class="draft">Draft</span>}
    </span>
    <h2 class="title">{title}</h2>
    <p class="desc">{description}</p>
  </a>

  {
    tags.length > 0 && (
      <div class="tags">
        <TagList tags={tags} />
      </div>
    )
  }
</article>

<style>
  .item {
    border-block-start: var(--hairline) solid var(--rule);
  }

  /* The surface bleeds a gutter past the text on hover: the row lifts without
     a shadow. Tags sit outside the link so they stay separate targets. */
  .link {
    display: block;
    margin-inline: calc(-1 * var(--s-4));
    padding: var(--s-6) var(--s-4) var(--s-2);
    border-radius: var(--r-2);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }

  .link:hover,
  .link:focus-visible {
    background: var(--surface);
    color: inherit;
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .date {
    font-family: var(--face-mono);
    font-size: var(--t-eyebrow);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-seq);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .part,
  .minutes {
    font-family: var(--face-mono);
    font-size: var(--t-eyebrow);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-seq);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .part::before,
  .minutes::before {
    content: '·';
    margin-inline-end: var(--s-3);
    opacity: 0.6;
  }

  .draft {
    font-family: var(--face-mono);
    font-size: var(--t-eyebrow);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-seq);
    text-transform: uppercase;
    color: var(--accent);
  }

  .title {
    margin-block-start: var(--s-3);
    font-size: var(--t-h3);
    font-weight: var(--w-semibold);
    line-height: 1.3;
    color: var(--fg);
    transition: color var(--dur) var(--ease);
  }

  .link:hover .title {
    color: var(--accent);
  }

  .desc {
    margin-block-start: var(--s-2);
    max-width: var(--w-text);
    color: var(--muted);
  }

  .tags {
    padding-block: var(--s-2) var(--s-6);
  }
</style>

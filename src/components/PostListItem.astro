---
import FormattedDate from './FormattedDate.astro';
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, description, tags, draft } = post.data;
---

<article class="item">
  <a href={`/blog/${post.id}/`} class="link">
    <span class="row">
      {/* Mono date rather than a counter: an index position shifts every time a
          post is added, so "01" would not mean anything stable. */}
      <FormattedDate date={date} format="iso" class="date" />
      {draft && <span class="draft">Draft</span>}
    </span>
    <h2 class="title">{title}</h2>
    <p class="desc">{description}</p>
  </a>

  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li>
            <a href={`/tags/${tag}/`} class="tag">
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .item {
    padding-block: var(--s-6);
    border-block-start: 1px solid var(--rule);
  }

  .link {
    display: block;
    text-decoration: none;
  }

  .link:hover {
    color: inherit;
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .date {
    font-family: var(--face-mono);
    font-size: var(--t-eyebrow);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-seq);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .draft {
    font-family: var(--face-mono);
    font-size: var(--t-eyebrow);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-seq);
    text-transform: uppercase;
    color: var(--accent);
  }

  .title {
    margin-block-start: var(--s-3);
    font-size: var(--t-h3);
    font-weight: var(--w-semibold);
    line-height: 1.3;
    color: var(--fg);
  }

  .link:hover .title {
    color: var(--accent);
  }

  .desc {
    margin-block-start: var(--s-2);
    max-width: var(--w-text);
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    margin-block-start: var(--s-3);
    padding: 0;
    list-style: none;
  }

  .tag {
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    color: var(--faint);
    text-decoration: none;
  }

  .tag::before {
    content: '#';
    opacity: 0.6;
  }

  .tag:hover {
    color: var(--accent);
  }
</style>

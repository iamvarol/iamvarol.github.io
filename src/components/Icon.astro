---
// Hand-drawn, matching the stroke convention already used by ThemeToggle's
// sun/moon and CareerTimeline's chevron/play/pause: 24x24, stroke only, no
// fill, round caps/joins. Sized in em so it tracks whatever text size it sits
// next to, rather than one fixed button size like ThemeToggle's icon.
import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === 'github' && (
      <path d="M12 3a9 9 0 0 0-2.85 17.54c.45.08.62-.2.62-.44 0-.22-.01-.94-.01-1.7-2.5.55-3.03-1.2-3.03-1.2-.4-1.03-1-1.3-1-1.3-.82-.56.06-.55.06-.55.9.06 1.38.93 1.38.93.8 1.38 2.1.98 2.62.75.08-.58.32-.98.58-1.2-2-.23-4.1-1.02-4.1-4.53 0-1 .35-1.82.92-2.46-.09-.23-.4-1.15.09-2.4 0 0 .75-.24 2.47.94a8.4 8.4 0 0 1 4.5 0c1.72-1.18 2.47-.94 2.47-.94.5 1.25.18 2.17.09 2.4.57.64.92 1.46.92 2.46 0 3.52-2.1 4.29-4.11 4.52.33.29.62.85.62 1.72 0 1.24-.01 2.24-.01 2.55 0 .24.16.53.63.44A9 9 0 0 0 12 3Z" />
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M7.5 10.7v5.8" />
        <circle cx="7.5" cy="7.4" r="0.15" />
        <path d="M11.4 16.5v-3.6c0-1.5.95-2.4 2.2-2.4s2.15.9 2.15 2.4v3.6" />
        <path d="M11.4 10.7v5.8" />
      </>
    )
  }
  {
    name === 'stack-overflow' && (
      <>
        <path d="M6 18v-2.3h12V18a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1Z" />
        <path d="M7.2 12.6 17 14.4" />
        <path d="M8.2 9.6l9.2 3.3" />
        <path d="M9.8 6.7l8.4 4.6" />
      </>
    )
  }
  {
    name === 'x' && (
      <>
        <path d="M5 5l14 14" />
        <path d="M19 5 5 19" />
      </>
    )
  }
  {
    name === 'rss' && (
      <>
        <path d="M4.5 4.5a15 15 0 0 1 15 15" />
        <path d="M4.5 10.3a9.2 9.2 0 0 1 9.2 9.2" />
        <circle cx="6.3" cy="17.7" r="1.4" />
      </>
    )
  }
  {
    name === 'external' && (
      <>
        <path d="M9.5 6H6.8A1.8 1.8 0 0 0 5 7.8v9.4A1.8 1.8 0 0 0 6.8 19h9.4a1.8 1.8 0 0 0 1.8-1.8v-2.7" />
        <path d="M14 4.5h5.5V10" />
        <path d="M19.3 4.7 11 13" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s7-6.7 7-12.2a7 7 0 1 0-14 0C5 14.3 12 21 12 21Z" />
        <circle cx="12" cy="8.8" r="2.3" />
      </>
    )
  }
</svg>

<style>
  .icon {
    inline-size: 1em;
    block-size: 1em;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

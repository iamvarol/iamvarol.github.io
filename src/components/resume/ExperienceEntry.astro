---
import { formatRange } from '../../lib/resume';

interface Props {
  company: string;
  role: string;
  location?: string;
  start: string;
  end: string | null;
  context?: string;
  highlights: string[];
  stack?: string[];
  tone: number;
  /** Anchor target, so a case study can point back at the role it came from. */
  id?: string;
  /** The case study written up from this role, when one is published. */
  caseStudy?: { href: string; title: string };
}

// Roles are deliberately not numbered. The sections already carry 01–06, and a
// second zero-padded sequence inside them reads as two competing systems — the
// PDF numbers sections only, so this keeps both renderings speaking the same
// visual language.
const {
  company,
  role,
  location,
  start,
  end,
  context,
  highlights,
  stack = [],
  tone,
  id,
  caseStudy,
} = Astro.props;
---

<article class="role" id={id}>
  <div class="body">
    <header class="head">
      <h3 class="title">
        {role} <span class="at">·</span> <span class="company">{company}</span>
      </h3>
      <p class="when" style={`--chip-bg: var(--tone-${tone})`}>
        {formatRange(start, end)}{location && <> <span aria-hidden="true">·</span> {location}</>}
      </p>
      {context && <p class="context">{context}</p>}
    </header>

    <ul class="highlights">
      {highlights.map((item) => <li>{item}</li>)}
    </ul>

    {
      stack.length > 0 && (
        <p class="stack">
          {stack.map((tool, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">·</span>}
              <span>{tool}</span>
            </>
          ))}
        </p>
      )
    }

    {
      caseStudy && (
        <p class="more">
          <a href={caseStudy.href}>Case study: {caseStudy.title} →</a>
        </p>
      )
    }
  </div>
</article>

<style>
  .role {
    padding-block: var(--s-6);
    border-block-start: var(--hairline) solid var(--rule);
    /* Jumped to from a case study: keep the heading clear of the top edge. */
    scroll-margin-block-start: var(--s-7);
    break-inside: avoid;
  }

  .title {
    font-size: var(--t-h3);
    font-weight: var(--w-semibold);
    line-height: 1.35;
    letter-spacing: -0.012em;
    color: var(--fg);
  }

  .at {
    color: var(--faint);
    font-weight: var(--w-regular);
  }

  .company {
    color: var(--accent);
  }

  .when {
    display: inline-block;
    margin-block-start: var(--s-2);
    padding-inline: var(--s-2);
    border-radius: var(--r-1);
    background: var(--chip-bg);
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    /* --faint fails AA once the chip sits on --tone-1 (4.04:1) — see
       tokens.css's tone-ramp note and CareerTimeline's own card text. */
    color: var(--muted);
  }

  .context {
    margin-block-start: var(--s-3);
    max-width: var(--w-text);
    font-size: var(--t-small);
    color: var(--muted);
  }

  .highlights {
    margin-block-start: var(--s-4);
    max-width: var(--w-text);
    padding-inline-start: 1.1em;
    color: var(--muted);
  }

  .highlights li + li {
    margin-block-start: var(--s-3);
  }

  .highlights li::marker {
    color: var(--faint);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    color: var(--faint);
  }

  .sep {
    opacity: 0.5;
  }

  .more {
    margin-block-start: var(--s-4);
    font-size: var(--t-small);
  }

  .more a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .more a:hover {
    color: var(--accent);
  }
</style>

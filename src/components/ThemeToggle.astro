---
// The only client-side JavaScript on the site. No framework needed: there is no
// state beyond one string and no rendering beyond swapping an attribute.
// The no-flash half of this lives inline in BaseHead, which must run pre-paint.
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light theme">
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.6v2.6M12 18.8v2.6M2.6 12h2.6M18.8 12h2.6M5.4 5.4l1.9 1.9M16.7 16.7l1.9 1.9M18.6 5.4l-1.9 1.9M7.3 16.7l-1.9 1.9"></path>
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z"></path>
  </svg>
</button>

<style>
  /* Hidden until the inline script confirms JS is running. */
  .theme-toggle {
    display: none;
  }

  :global(html.js) .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    margin-inline-start: calc(var(--s-1) * -1);
    border-radius: 999px;
    color: var(--muted);
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--fg);
    background: var(--surface-hover);
  }

  .icon {
    inline-size: 1.05rem;
    block-size: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the icon for the theme you would switch *to*. */
  .icon-sun {
    display: none;
  }

  :global(html[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(html[data-theme='dark']) .icon-moon {
    display: none;
  }
</style>

<script>
  const LABELS = {
    dark: 'Switch to light theme',
    light: 'Switch to dark theme',
  } as const;

  const root = document.documentElement;

  const sync = (button: HTMLElement) => {
    const theme = root.dataset.theme === 'light' ? 'light' : 'dark';
    button.setAttribute('aria-label', LABELS[theme]);
  };

  for (const button of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
    sync(button);

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Persisting is best-effort; the swap itself still works.
      }
      sync(button);
    });
  }
</script>

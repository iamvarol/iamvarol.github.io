---
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Eyebrow from '../components/Eyebrow.astro';
import TagList from '../components/TagList.astro';
import Icon from '../components/Icon.astro';
import { readingTime, seriesFor, type Post } from '../lib/posts';
import { site } from '../lib/site';
import '../styles/prose.css';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, description, tags, draft, link, link_text } = post.data;
const minutes = readingTime(post.body);
const series = await seriesFor(post);
---

<Base title={`${title} — ${site.name}`} description={description} type="article" noindex={draft}>
  <article class="wrap post">
    <header class="head">
      {draft && <Eyebrow accent>Draft — not published</Eyebrow>}

      <h1 class="title">{title}</h1>

      <p class="meta">
        <FormattedDate date={date} />
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {
          series && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Part {series.part} of {series.total},{' '}
                <a href={`/series/${series.series.id}/`}>{series.series.data.title}</a>
              </span>
            </>
          )
        }
      </p>

      {link && (
        <p class="crosspost">
          <a href={link} target="_blank" rel="noopener noreferrer">
            <Icon name="external" />
            {link_text}
          </a>
        </p>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <footer class="foot">
          <Eyebrow>Tagged</Eyebrow>
          <TagList tags={tags} />
        </footer>
      )
    }

    {
      series && (series.prev || series.next) && (
        <nav class="pager" aria-label={`More of ${series.series.data.title}`}>
          {series.prev && (
            <a class="pager-link" href={`/blog/${series.prev.id}/`} rel="prev">
              <span class="pager-dir">← Part {series.prev.data.part}</span>
              <span class="pager-title">{series.prev.data.title}</span>
            </a>
          )}
          {series.next && (
            <a class="pager-link is-next" href={`/blog/${series.next.id}/`} rel="next">
              <span class="pager-dir">Part {series.next.data.part} →</span>
              <span class="pager-title">{series.next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    <p class="back"><a href="/blog/">← All posts</a></p>
  </article>
</Base>

<style>
  .post {
    /* Narrower than --w-wide: a post is prose, so the measure governs. */
    max-width: calc(var(--w-text) + var(--gutter) * 2);
    padding-block: var(--s-section);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding-block-end: var(--s-6);
  }

  .title {
    font-family: var(--face-display);
    font-weight: var(--w-semibold);
    font-size: var(--t-display);
    line-height: var(--lh-display);
    letter-spacing: var(--tr-display);
    color: var(--fg);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    color: var(--faint);
  }

  .meta a {
    color: var(--muted);
  }

  .crosspost {
    font-family: var(--face-mono);
    font-size: var(--t-small);
  }

  .crosspost a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .crosspost a:hover {
    color: var(--accent);
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-5);
    border-block-start: var(--hairline) solid var(--rule);
  }

  /* Previous / next part of the series. */
  .pager {
    display: grid;
    gap: var(--s-4);
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-block-start: var(--hairline) solid var(--rule);
  }

  @media (min-width: 40rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .is-next {
      grid-column: 2;
      text-align: end;
    }
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    color: var(--fg);
    text-decoration: none;
  }

  .pager-dir {
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    color: var(--faint);
  }

  .pager-title {
    font-size: var(--t-small);
    text-wrap: balance;
    transition: color var(--dur) var(--ease);
  }

  .pager-link:hover .pager-title {
    color: var(--accent);
  }

  .back {
    margin-block-start: var(--s-7);
    font-size: var(--t-small);
  }

  .back a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .back a:hover {
    color: var(--accent);
  }
</style>

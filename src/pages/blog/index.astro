---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostListItem from '../../components/PostListItem.astro';
import TagList from '../../components/TagList.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, getTags } from '../../lib/posts';
import { site } from '../../lib/site';

const posts = await getPosts();
const tags = await getTags();
const tagCounts = Object.fromEntries(tags.map(({ tag, count }) => [tag, count]));
---

<Base title={`Blog — ${site.shortName}`} description={`Writing by ${site.name}.`}>
  <div class="wrap page">
    <SectionHeading as="h1" size="display" eyebrow="Writing">Blog</SectionHeading>

    {
      tags.length > 0 && (
        <div class="taglist">
          <TagList tags={tags.map((t) => t.tag)} counts={tagCounts} />
        </div>
      )
    }

    {
      posts.length > 0 ? (
        <div class="list">
          {posts.map((post) => (
            <PostListItem post={post} />
          ))}
        </div>
      ) : (
        /* Visitor-facing copy. Authoring instructions belong in CLAUDE.md and the
           post template, not on a page a recruiter might land on. */
        <p class="empty">Nothing published yet.</p>
      )
    }

    <p class="feed">
      <a href="/rss.xml">
        <Icon name="rss" />
        RSS feed
      </a>
    </p>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-section);
  }

  .taglist {
    margin-block-start: var(--s-6);
  }

  .list {
    margin-block-start: var(--s-7);
  }

  .empty {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-6);
    border-block-start: 1px solid var(--rule);
    max-width: var(--w-text);
    color: var(--muted);
  }

  .empty code {
    color: var(--fg);
  }

  .feed {
    margin-block-start: var(--s-7);
    font-size: var(--t-small);
  }

  .feed a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .feed a:hover {
    color: var(--accent);
  }
</style>

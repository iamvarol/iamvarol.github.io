---
import { render } from 'astro:content';
import PostLayout from '../../layouts/Post.astro';
import { getPosts, type Post } from '../../lib/posts';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  // getPosts() already drops drafts in production, so a draft has no route at
  // all rather than an unlinked-but-reachable one.
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

// getStaticPaths' props are `unknown` to the page by default, so declare the
// shape rather than letting `render(post)` fall through to an `any`.
const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
---

<PostLayout post={post}>
  <Content />
</PostLayout>

---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostListItem from '../components/PostListItem.astro';
import PostTimeline from '../components/PostTimeline.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Portrait from '../components/Portrait.astro';
import ForecastBand from '../components/ForecastBand.astro';
import WorkListItem from '../components/WorkListItem.astro';
import Icon from '../components/Icon.astro';
import { site, socials } from '../lib/site';
import { getPosts } from '../lib/posts';
import { getLanding, getCareerStages } from '../lib/resume';
import { getWork } from '../lib/work';
import { approved } from '../lib/gate';
import { person, webSite } from '../lib/jsonld';

const { hero, focus, proof } = await getLanding();
// Empty until a case study clears its markers; the section then appears on
// its own, before the focus list, because it is the evidence for it.
const work = (await getWork()).slice(0, 4);
const stages = await getCareerStages(
  'career',
  new Map(work.map((s) => [s.company, s.href])),
);

// His line, not mine: withheld until the marker in landing.yml is gone.
const status = approved(hero.status);

// One read, two depths: three cards with descriptions, then five titles as a
// chronological index. /blog/ stays the full archive.
const all = await getPosts();
const posts = all.slice(0, 3);
const timeline = all.slice(0, 5);
const links = socials.filter((s) => s.primary);
---

{/* Person + WebSite, so a search result for his name carries the role and the
    profile links rather than a bare title tag. */}
<Base title={site.title} description={site.description} schema={[webSite(), person()]}>

  <section class="wrap hero">
    <div class="intro">
      <p class="enter" style="--i: 0"><Eyebrow>{site.tagline}</Eyebrow></p>

      {/* No entrance on the name: it is the LCP element on a phone, and Chrome
          skips anything at opacity 0 when it picks one. */}
      <h1 class="name">{site.name}</h1>

      <p class="statement enter" style="--i: 1">{hero.statement}</p>

      {
        status &&
          (status.href ? (
            <a class="status enter" style="--i: 2" href={status.href}>
              {status.text}
            </a>
          ) : (
            <p class="status enter" style="--i: 2">
              {status.text}
            </p>
          ))
      }

      <div class="actions enter" style="--i: 3">
        <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>
        {
          hero.secondary && (
            <a class="quiet" href={hero.secondary.href} download>
              {hero.secondary.label}
            </a>
          )
        }
        <a class="quiet" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>

    <div class="figure">
      <Portrait size="hero" priority />
    </div>

    {
      proof && (
        <dl class="proof enter" style="--i: 4">
          {proof.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="band-wrap enter" style="--i: 5">
      <ForecastBand />
    </div>
  </section>

  {
    work.length > 0 && (
      <section class="wrap block reveal" aria-labelledby="selected">
        <SectionHeading eyebrow="Work" id="selected">Selected work</SectionHeading>
        <ol class="cases">
          {work.map((s, i) => (
            <WorkListItem study={s} active={i === 0} />
          ))}
        </ol>
        <p class="more">
          <a href="/work/">All case studies →</a>
        </p>
      </section>
    )
  }

  <section class="wrap block reveal" aria-labelledby="work">
    <SectionHeading eyebrow="Focus" id="work">What I work on</SectionHeading>

    <ol class="work">
      {
        focus.map((item, i) => (
          <li class="item">
            {/* Only the first number takes the accent — the reference's tell, and
                what makes the sequence read as a system rather than decoration. */}
            <span class="seq" data-active={i === 0 ? '' : undefined} aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="item-title">{item.title}</h3>
              <p class="item-detail">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap block reveal" aria-labelledby="background">
    <SectionHeading eyebrow="Background" id="background">How I got here</SectionHeading>
    <p class="bio">{site.bio}</p>

    {/* Twenty years in one horizontal read, most recent first. The full bullets
        for each of these live on /resume. */}
    <CareerTimeline stages={stages} />
  </section>

  {
    posts.length > 0 && (
      <section class="wrap block reveal" aria-labelledby="writing">
        <SectionHeading eyebrow="Writing" id="writing">Recent posts</SectionHeading>
        <div class="posts">
          {posts.map((post) => (
            <PostListItem post={post} />
          ))}
        </div>
        <div class="timeline-block">
          <Eyebrow>Timeline</Eyebrow>
          <PostTimeline posts={timeline} />
        </div>

        <p class="more">
          <a href="/blog/">All posts →</a>
        </p>
      </section>
    )
  }

  <section class="wrap block reveal" aria-labelledby="contact">
    <SectionHeading eyebrow="Contact" id="contact">Get in touch</SectionHeading>
    <p class="bio">
      Based in {site.location}. The fastest way to reach me is email.
    </p>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'me noopener noreferrer' : undefined}
            >
              <Icon name={link.icon} />
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* One column on a phone, the portrait first as an avatar; from 48rem the
     intro takes the left column and the portrait stands at the right edge of
     the same row, bottom-aligned with the actions. The proof strip and the
     forecast band span both. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(3rem, 2rem + 6vw, 7rem) var(--s-8);
  }

  .figure {
    order: -1;
    margin-block-end: var(--s-5);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: clamp(var(--s-7), 6vw, var(--s-9));
      align-items: end;
    }

    .intro {
      grid-column: 1;
      grid-row: 1;
    }

    .figure {
      order: 0;
      grid-column: 2;
      grid-row: 1;
      margin: 0;
    }

    .proof,
    .band-wrap {
      grid-column: 1 / -1;
    }
  }

  .name {
    margin-block-start: var(--s-5);
    font-family: var(--face-display);
    font-weight: var(--w-semibold);
    font-size: var(--t-hero);
    line-height: var(--lh-hero);
    letter-spacing: var(--tr-hero);
    color: var(--fg);
  }

  .statement {
    margin-block-start: var(--s-5);
    max-width: 34ch;
    font-size: var(--t-statement);
    line-height: 1.4;
    letter-spacing: -0.012em;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* The availability line. A status indicator, not a sequence marker — hence
     a dot, not a .seq — and mono because it is metadata about the person. */
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-block-start: var(--s-5);
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .status::before {
    content: '';
    flex: none;
    inline-size: var(--s-2);
    block-size: var(--s-2);
    border-radius: var(--r-pill);
    background: var(--accent);
  }

  a.status:hover {
    color: var(--accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
    margin-block-start: var(--s-7);
  }

  /* Proof strip: the figures a hiring manager can carry into a debrief. The
     numbers take the display face at display size; the captions are mono
     metadata. Values first visually, labels first in the markup — a <dl> reads
     label then value, so the column is reversed. No ordinals: this page's
     01–05 belongs to the focus list below. */
  .proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-6);
    margin: var(--s-8) 0 0;
    padding-block-start: var(--s-6);
    border-block-start: var(--hairline) solid var(--rule);
  }

  @media (min-width: 48rem) {
    .proof {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .proof > div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--s-2);
  }

  .proof dd {
    margin: 0;
    font-family: var(--face-display);
    font-weight: var(--w-semibold);
    font-size: var(--t-display);
    line-height: 1;
    letter-spacing: var(--tr-display);
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .proof dt {
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }

  .band-wrap {
    margin-block-start: var(--s-8);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--s-3) var(--s-5);
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--t-small);
    font-weight: var(--w-semibold);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }

  .btn:hover {
    background: var(--accent-strong);
    color: var(--on-accent);
  }

  .quiet {
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .quiet:hover {
    color: var(--accent);
  }

  .block {
    padding-block: var(--s-section);
    border-block-start: 1px solid var(--rule);
  }

  .cases {
    margin-block-start: var(--s-7);
    padding: 0;
    list-style: none;
  }

  /* Numbered sequence ---------------------------------------------------- */
  .work {
    margin-block-start: var(--s-7);
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--s-4);
    padding-block: var(--s-5);
    border-block-start: 1px solid var(--rule);
  }

  .item:first-child {
    border-block-start: none;
  }

  @media (max-width: 34rem) {
    .item {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }

  .seq {
    padding-block-start: 0.4rem;
  }

  .item-title {
    font-size: var(--t-h3);
    font-weight: var(--w-semibold);
    line-height: 1.3;
    color: var(--fg);
  }

  .item-detail {
    margin-block-start: var(--s-2);
    max-width: var(--w-text);
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Background / contact -------------------------------------------------- */
  .bio {
    margin-block-start: var(--s-5);
    max-width: var(--w-text);
    font-size: var(--t-lead);
    color: var(--muted);
    text-wrap: pretty;
  }

  .posts {
    margin-block-start: var(--s-6);
  }

  .timeline-block {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    margin-block-start: var(--s-7);
  }

  .more {
    margin-block-start: var(--s-5);
    font-size: var(--t-small);
  }

  .more a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .more a:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    margin-block-start: var(--s-5);
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-size: var(--t-small);
    color: var(--fg);
    text-decoration: none;
  }

  .links a span {
    border-block-end: 1px solid var(--rule-strong);
    padding-block-end: 2px;
    transition: border-color var(--dur) var(--ease);
  }

  .links a:hover {
    color: var(--accent);
    transition: color var(--dur) var(--ease);
  }

  .links a:hover span {
    border-color: var(--accent);
  }
</style>

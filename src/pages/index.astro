---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostListItem from '../components/PostListItem.astro';
import PostTimeline from '../components/PostTimeline.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import { site, socials } from '../lib/site';
import { getPosts } from '../lib/posts';
import { getLanding, getCareerStages } from '../lib/resume';

const { hero, work } = await getLanding();
const stages = await getCareerStages();

// One read, two depths: three cards with descriptions, then five titles as a
// chronological index. /blog/ stays the full archive.
const all = await getPosts();
const posts = all.slice(0, 3);
const timeline = all.slice(0, 5);
const links = socials.filter((s) => s.primary);

// Person markup so a search result for his name can carry the role and the
// profile links rather than a bare title tag.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.shortName,
  jobTitle: site.tagline,
  description: site.bio,
  email: `mailto:${site.email}`,
  url: site.url,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  sameAs: socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<Base title={site.title} description={site.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <section class="wrap hero">
    <Eyebrow>{site.tagline}</Eyebrow>
    <h1 class="name">{site.name}</h1>
    <p class="statement">{hero.statement}</p>

    <div class="actions">
      <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>
      <a class="quiet" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="work">
    <SectionHeading eyebrow="Focus" id="work">What I work on</SectionHeading>

    <ol class="work">
      {
        work.map((item, i) => (
          <li class="item">
            {/* Only the first number takes the accent — the reference's tell, and
                what makes the sequence read as a system rather than decoration. */}
            <span class="seq" data-active={i === 0 ? '' : undefined} aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="item-title">{item.title}</h3>
              <p class="item-detail">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap block" aria-labelledby="background">
    <SectionHeading eyebrow="Background" id="background">How I got here</SectionHeading>
    <p class="bio">{site.bio}</p>

    {/* Twenty years in one horizontal read, most recent first. The full bullets
        for each of these live on /resume. */}
    <CareerTimeline stages={stages} />
  </section>

  {
    posts.length > 0 && (
      <section class="wrap block" aria-labelledby="writing">
        <SectionHeading eyebrow="Writing" id="writing">Recent posts</SectionHeading>
        <div class="posts">
          {posts.map((post) => (
            <PostListItem post={post} />
          ))}
        </div>
        <div class="timeline-block">
          <Eyebrow>Timeline</Eyebrow>
          <PostTimeline posts={timeline} />
        </div>

        <p class="more">
          <a href="/blog/">All posts →</a>
        </p>
      </section>
    )
  }

  <section class="wrap block" aria-labelledby="contact">
    <SectionHeading eyebrow="Contact" id="contact">Get in touch</SectionHeading>
    <p class="bio">
      Based in {site.location}. The fastest way to reach me is email.
    </p>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 3rem + 8vw, 9rem) var(--s-8);
  }

  .name {
    margin-block-start: var(--s-5);
    font-size: var(--t-hero);
    line-height: var(--lh-hero);
    letter-spacing: var(--tr-hero);
    color: var(--fg);
  }

  .statement {
    margin-block-start: var(--s-5);
    max-width: 34ch;
    font-size: clamp(1.15rem, 0.95rem + 0.9vw, 1.6rem);
    line-height: 1.4;
    letter-spacing: -0.012em;
    color: var(--muted);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
    margin-block-start: var(--s-7);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--s-3) var(--s-5);
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--t-small);
    font-weight: var(--w-semibold);
    text-decoration: none;
  }

  .btn:hover {
    background: var(--accent-strong);
    color: var(--on-accent);
  }

  .quiet {
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    color: var(--muted);
    text-decoration: none;
  }

  .quiet:hover {
    color: var(--accent);
  }

  .block {
    padding-block: var(--s-section);
    border-block-start: 1px solid var(--rule);
  }

  /* Numbered sequence ---------------------------------------------------- */
  .work {
    margin-block-start: var(--s-7);
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--s-4);
    padding-block: var(--s-5);
    border-block-start: 1px solid var(--rule);
  }

  .item:first-child {
    border-block-start: none;
  }

  @media (max-width: 34rem) {
    .item {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }

  .seq {
    padding-block-start: 0.4rem;
  }

  .item-title {
    font-size: var(--t-h3);
    font-weight: var(--w-semibold);
    line-height: 1.3;
    color: var(--fg);
  }

  .item-detail {
    margin-block-start: var(--s-2);
    max-width: var(--w-text);
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Background / contact -------------------------------------------------- */
  .bio {
    margin-block-start: var(--s-5);
    max-width: var(--w-text);
    font-size: var(--t-lead);
    color: var(--muted);
    text-wrap: pretty;
  }

  .posts {
    margin-block-start: var(--s-6);
  }

  .timeline-block {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    margin-block-start: var(--s-7);
  }

  .more {
    margin-block-start: var(--s-5);
    font-size: var(--t-small);
  }

  .more a {
    color: var(--muted);
    text-decoration: none;
  }

  .more a:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    margin-block-start: var(--s-5);
    padding: 0;
    list-style: none;
  }

  .links a {
    font-size: var(--t-small);
    color: var(--fg);
    text-decoration: none;
    border-block-end: 1px solid var(--rule-strong);
    padding-block-end: 2px;
  }

  .links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

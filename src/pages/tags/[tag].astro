---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getTags, getPostsByTag } from '../../lib/posts';
import type { GetStaticPaths } from 'astro';
import { site } from '../../lib/site';
import { breadcrumbs } from '../../lib/jsonld';

export const getStaticPaths: GetStaticPaths = async () => {
  const tags = await getTags();
  return tags.map(({ tag }) => ({ params: { tag } }));
};

const { tag } = Astro.params;
const posts = await getPostsByTag(tag!);
const count = `${posts.length} post${posts.length === 1 ? '' : 's'}`;
---

{/* noindex while the Playbook posts share one tag set and these pages
    duplicate each other; the sitemap filter in astro.config.mjs matches. */}
<Base
  title={`#${tag} — ${site.name}`}
  description={`Posts tagged ${tag} — ${count}.`}
  noindex
  schema={[
    breadcrumbs([
      { name: site.shortName, path: '/' },
      { name: 'Writing', path: '/blog/' },
      { name: `#${tag}`, path: `/tags/${tag}/` },
    ]),
  ]}
>
  <div class="wrap page">
    <SectionHeading as="h1" size="display" eyebrow="Tag">#{tag}</SectionHeading>
    <p class="count">{count}</p>

    <div class="list">
      {posts.map((post) => <PostListItem post={post} />)}
    </div>

    <p class="back"><a href="/blog/">← All posts</a></p>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-section);
  }

  .count {
    margin-block-start: var(--s-4);
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    color: var(--faint);
  }

  .list {
    margin-block-start: var(--s-7);
  }

  .back {
    margin-block-start: var(--s-7);
    font-size: var(--t-small);
  }

  .back a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .back a:hover {
    color: var(--accent);
  }
</style>

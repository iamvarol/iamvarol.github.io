---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { site, socials } from '../lib/site';
import { getResume } from '../lib/resume';
import { approved, isPending } from '../lib/gate';
import { breadcrumbs } from '../lib/jsonld';

// No form, by request. A form on a static site needs a third-party endpoint,
// which means a network request, a privacy surface and a thing that can break
// silently between a recruiter hitting send and Emre not receiving it.
const links = socials.filter((s) => s.href.startsWith('http'));

const entry = await getEntry('contact', 'main');
if (!entry) throw new Error('contact entry "main" not found — check src/data/contact.yml');
const c = entry.data;

// His fields, gated one by one; the page itself is always live.
const responseTime = approved(c.responseTime);
const include = c.include.length > 0 && (approved(c.include) ?? []);
const { basics } = await getResume();
---

<Base
  title={`Contact — ${site.shortName}`}
  description={`How to reach ${site.name} — email, LinkedIn and GitHub.`}
  schema={[
    breadcrumbs([
      { name: site.shortName, path: '/' },
      { name: 'Contact', path: '/contact/' },
    ]),
  ]}
>
  <div class="wrap page">
    <SectionHeading as="h1" size="display" eyebrow="Contact">Get in touch</SectionHeading>

    <p class="lead intro">{c.intro}</p>

    <dl class="channels">
      <div class="channel">
        <dt>Email</dt>
        <dd>
          <a class="primary" href={`mailto:${site.email}`}>
            <Icon name="mail" />
            <span>{site.email}</span>
          </a>
        </dd>
      </div>

      {
        links.map((link) => (
          <div class="channel">
            <dt>{link.label}</dt>
            <dd>
              <a href={link.href} target="_blank" rel="me noopener noreferrer">
                <Icon name={link.icon} />
                <span>{link.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
              </a>
            </dd>
          </div>
        ))
      }

      <div class="channel">
        <dt>Time zone</dt>
        <dd class="plain">
          {site.timezone} <span class="quiet">({site.utcOffset})</span>
        </dd>
      </div>

      {
        basics.languages && (
          <div class="channel">
            <dt>Languages</dt>
            <dd class="plain">
              {basics.languages.map((l, i) => (
                <>
                  {i > 0 && <span class="quiet" aria-hidden="true"> · </span>}
                  {l.name} <span class="quiet">({l.level})</span>
                </>
              ))}
            </dd>
          </div>
        )
      }

      {
        responseTime && (
          <div class="channel">
            <dt>Reply time</dt>
            <dd class:list={['plain', isPending(responseTime) && 'pending']}>
              {responseTime}
            </dd>
          </div>
        )
      }
    </dl>

    {
      include && include.length > 0 && (
        <section class="include" aria-labelledby="include">
          <h2 id="include" class="include-title">When you write</h2>
          <ul class:list={['include-list', isPending(include) && 'pending']}>
            {include.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )
    }

    <p class="aside">
      Looking for the CV? The <a href="/resume/">resume</a> is on this site, and there is a{' '}
      <a href={site.resumePdf} download>PDF</a> if you need something to forward.
    </p>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-section);
  }

  .intro {
    margin-block-start: var(--s-5);
    max-width: var(--w-text);
  }

  .channels {
    margin-block-start: var(--s-7);
  }

  .channel {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-block-start: var(--hairline) solid var(--rule);
  }

  @media (max-width: 32rem) {
    .channel {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }

  dt {
    font-family: var(--face-mono);
    font-size: var(--t-eyebrow);
    font-weight: var(--w-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tr-eyebrow);
    line-height: 1.9;
    color: var(--faint);
  }

  dd {
    margin: 0;
  }

  .plain {
    color: var(--fg);
  }

  .quiet {
    color: var(--faint);
  }

  dd a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--fg);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  dd a span {
    border-block-end: var(--hairline) solid var(--rule-strong);
    padding-block-end: 2px;
    /* Long handles must not push the page wide on a phone. */
    overflow-wrap: anywhere;
    transition: border-color var(--dur) var(--ease);
  }

  dd a:hover {
    color: var(--accent);
  }

  dd a:hover span {
    border-color: var(--accent);
  }

  .primary {
    font-size: var(--t-lead);
  }

  .include {
    margin-block-start: var(--s-8);
    max-width: var(--w-text);
  }

  .include-title {
    font-size: var(--t-h3);
    font-weight: var(--w-semibold);
    color: var(--fg);
  }

  .include-list {
    margin-block-start: var(--s-4);
    padding-inline-start: 1.1em;
    color: var(--muted);
  }

  .include-list li + li {
    margin-block-start: var(--s-2);
  }

  .include-list li::marker {
    color: var(--faint);
  }

  /* Dev only: a placeholder still carrying its marker reads as one. */
  .pending {
    color: var(--accent);
    font-family: var(--face-mono);
    font-size: var(--t-small);
  }

  .aside {
    margin-block-start: var(--s-7);
    max-width: var(--w-text);
    font-size: var(--t-small);
    color: var(--muted);
  }

  .aside a {
    color: var(--accent);
  }
</style>

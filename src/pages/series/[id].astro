---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getSeriesList, type Post, type Series } from '../../lib/posts';
import { site } from '../../lib/site';
import { breadcrumbs } from '../../lib/jsonld';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const list = await getSeriesList();
  return list.map(({ series, posts }) => ({ params: { id: series.id }, props: { series, posts } }));
};

const { series, posts } = Astro.props as { series: Series; posts: Post[] };
const count = `${posts.length} part${posts.length === 1 ? '' : 's'}`;
---

<Base
  title={`${series.data.title} — ${site.name}`}
  description={series.data.description ?? `${series.data.title}: ${count}, by ${site.name}.`}
  schema={[
    breadcrumbs([
      { name: site.shortName, path: '/' },
      { name: 'Blog', path: '/blog/' },
      { name: series.data.title, path: `/series/${series.id}/` },
    ]),
  ]}
>
  <div class="wrap page">
    <SectionHeading as="h1" size="display" eyebrow="Series">
      {series.data.title}
      {series.data.description && <Fragment slot="sub">{series.data.description}</Fragment>}
    </SectionHeading>
    <p class="count">{count}, in reading order</p>

    <div class="list">
      {posts.map((post) => <PostListItem post={post} />)}
    </div>

    <p class="back"><a href="/blog/">← All posts</a></p>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-section);
  }

  .count {
    margin-block-start: var(--s-4);
    font-family: var(--face-mono);
    font-size: var(--t-meta);
    color: var(--faint);
  }

  .list {
    margin-block-start: var(--s-7);
  }

  .back {
    margin-block-start: var(--s-7);
    font-size: var(--t-small);
  }

  .back a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .back a:hover {
    color: var(--accent);
  }
</style>
